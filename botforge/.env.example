# =============================================================================
# BotForge Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# --- Phase 0: Core ---
DATABASE_URL=postgresql+asyncpg://botforge:botforge@localhost:5432/botforge  # pragma: allowlist secret
DATABASE_URL_TEST=postgresql+asyncpg://botforge:botforge@localhost:5433/botforge_test  # pragma: allowlist secret
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
DEMO_MODE_ENABLED=true
DEMO_SESSION_MINUTES=30
CORS_ORIGINS=http://localhost:3000
CORS_WIDGET_ORIGINS=*
API_RATE_LIMIT=100
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Phase 1: Conversation Engine (uncomment when needed) ---
# GROQ_API_KEY=
# OPENAI_API_KEY=
# DEFAULT_LLM_PROVIDER=groq
# DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_TTL=3600
# PROMPT_GUARD_ENABLED=true
# EVENT_BUS_BACKEND=in_process
# TOKEN_BUDGET_DEFAULT=1000000
# TOKEN_BUDGET_WARN_PCT=80
# LLM_CONNECTION_POOL_SIZE=20
# WS_BROADCAST_BACKEND=local

# --- Phase 2: RAG Module (uncomment when needed) ---
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=botforge
# EMBEDDING_PROVIDER=local
# EMBEDDING_THREAD_POOL_SIZE=4
# FILE_STORAGE_BACKEND=local
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=botforge-uploads
# S3_USE_INSTANCE_ROLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MAX_UPLOAD_SIZE_MB=50
# ARQ_REDIS_URL=redis://localhost:6379
# ARQ_MAX_JOBS=10

# --- Phase 3: Voice (uncomment when needed) ---
# VAPI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1234567890
# HUBSPOT_API_KEY=
# GOOGLE_CALENDAR_CREDENTIALS=
# WEBHOOK_IDEMPOTENCY_TTL=86400

# --- Phase 4: Channels (uncomment when needed) ---
# DIALOGFLOW_PROJECT_ID=
# TELEGRAM_BOT_TOKEN=
# RESEND_API_KEY=
# CDN_WIDGET_URL=

# --- Phase 5: Analytics + GDPR (uncomment when needed) ---
# DATA_RETENTION_DAYS=365
# MATVIEW_REFRESH_INTERVAL=300
# SENTRY_DSN=

# --- Phase 9: Observability (Arize AX) ---
# ARIZE_SPACE_ID=
# ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=fenlo-ai

# --- Production (uncomment for deploy) ---
# BACKEND_URL=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com
