# =============================================================================
# BotForge Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# =============================================================================
# 🚀 REQUIRED FOR DEPLOYMENT
# =============================================================================

# --- Database & Cache ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fenlo_bot
# Production (AWS RDS): postgresql+asyncpg://botforge:PASSWORD@rds-endpoint:5432/botforge

REDIS_URL=redis://localhost:6379/0
# Production: redis://localhost:6379/0 (local Redis on EC2)

# --- Security ---
SECRET_KEY=change-me-to-a-random-string-min-32-chars
JWT_SECRET=change-me-to-a-random-string-min-32-chars

# --- LLM API Keys ---
GROQ_API_KEY=your-groq-api-key-here
# Get from: https://console.groq.com/keys (Free tier available)

OPENAI_API_KEY=your-openai-api-key-here
# Get from: https://platform.openai.com/api-keys (Fallback provider)

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:3000
# Production: Set to your domain (e.g., https://yourdomain.com)

CORS_ORIGINS=http://localhost:3000
# Production: Set to your domain (comma-separated for multiple origins)

# --- Application Settings ---
ENVIRONMENT=development
# Production: Set to "production"

LOG_FORMAT=console
# Production: Set to "json" for structured logging

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# --- Monitoring (Recommended for Production) ---
SENTRY_DSN=
# Get from: https://sentry.io (Optional but recommended)

SENTRY_ENABLED=false
# Production: Set to "true" to enable error tracking

SENTRY_ENVIRONMENT=development
# Production: Set to "production"

SENTRY_TRACES_SAMPLE_RATE=0.1
# Production: 10% sampling rate

# =============================================================================
# 📋 OPTIONAL / PHASE-SPECIFIC VARIABLES
# =============================================================================

# --- JWT Configuration ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Demo Mode ---
DEMO_MODE_ENABLED=true
DEMO_SESSION_MINUTES=30

# --- Phase 1: Conversation Engine ---
# RESPONSE_CACHE_TTL=3600
# TOKEN_BUDGET_WARNING_PERCENT=80

# --- Phase 2: RAG Module (Task 2.3, 2.4) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=botforge-vectors
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# AWS S3 File Storage (production uses EC2 IAM instance role — no keys needed)
FILE_STORAGE_BACKEND=local
# Production: Set to "s3"
AWS_REGION=us-east-1
S3_BUCKET_NAME=botforge-uploads
S3_USE_INSTANCE_ROLE=true
# Only set these if NOT using EC2 instance role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Phase 3: Voice (uncomment when needed) ---
# VAPI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Phase 4: Channels (uncomment when needed) ---
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# WIDGET_CDN_URL=

# --- Phase 5: Analytics (uncomment when needed) ---
